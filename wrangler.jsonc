{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-pro7",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bdbabae7-25d6-4df6-b50a-1bb186dfcd4e","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c2fef9edfae04b1e8f09bdb6ea8137ee" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
